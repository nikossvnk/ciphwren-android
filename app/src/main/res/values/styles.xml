<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- app theme: light or dark (values-night) as chosen in the app settings, in the brand's colours -->

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight">
        <!-- see https://github.com/material-components/material-components-android/blob/master/docs/theming/Color.md for component color names -->
        <item name="colorPrimary">@color/cw_primary</item>
        <!-- the status bar before Android 15 draws apps edge to edge -->
        <item name="colorPrimaryDark">@color/cw_background</item>
        <item name="colorPrimaryVariant">@color/cw_primary</item>
        <item name="colorOnPrimary">@color/cw_on_primary</item>

        <item name="colorSecondary">@color/cw_primary</item>
        <item name="colorSecondaryVariant">@color/cw_primary</item>
        <item name="colorOnSecondary">@color/cw_on_primary</item>

        <item name="colorError">@color/cw_error</item>
        <item name="colorOnError">@color/cw_on_error</item>

        <item name="android:colorBackground">@color/cw_background</item>
        <item name="colorOnBackground">@color/cw_text</item>
        <item name="colorSurface">@color/cw_surface</item>
        <item name="colorOnSurface">@color/cw_text</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="android:windowLightStatusBar">@bool/cw_light_system_bars</item>
        <item name="android:navigationBarColor" tools:targetApi="27">@color/cw_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/cw_light_system_bars</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/cw_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splashscreen_icon</item>

        <!-- the top bars are the colour of the screen, with a line under them -->
        <item name="actionBarStyle">@style/Widget.Ciphwren.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MaterialComponents.ActionBar.Surface</item>
        <item name="appBarLayoutStyle">@style/Widget.Ciphwren.AppBarLayout</item>
        <item name="cardViewStyle">@style/Widget.Ciphwren.CardView</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.Ciphwren.ActionBar" parent="Widget.MaterialComponents.ActionBar.Surface">
        <item name="background">@drawable/app_bar_background</item>
    </style>

    <style name="Widget.Ciphwren.AppBarLayout" parent="Widget.MaterialComponents.AppBarLayout.Surface">
        <item name="android:background">@drawable/app_bar_background</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Ciphwren.CardView" parent="CardView">
        <item name="cardBackgroundColor">@color/cw_surface</item>
    </style>


    <!-- AddAccountActivity -->

    <style name="login_type_headline">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="account_list_card">
        <item name="android:layout_width">match_parent</item>
    </style>

    <!-- NotificationHandlerActivity -->

    <style name="Theme.Transparent" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- stepper (wizard) -->

    <style name="stepper_nav_bar">
        <item name="android:background">@color/cw_surface_alt</item>
    </style>

    <style name="stepper_nav_button">
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">@color/buttontext</item>
    </style>


    <!-- widgets -->

    <!-- the tabs under the top bar: the colour of the screen too -->
    <style name="tablayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- the coloured headers of the cards on the account screen -->
    <style name="toolbar_theme">
        <item name="android:textColorSecondary">@color/cw_on_header</item>
    </style>
    <style name="toolbar_style" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/cw_header</item>
        <item name="titleTextColor">@color/cw_on_header</item>
    </style>


    <!-- text content -->

    <style name="TextView.Heading" parent="AppTheme">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/cw_primary</item>
    </style>

</resources>
